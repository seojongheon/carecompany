# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Safe local default. Set true in Vercel Production only after applying and verifying
# supabase/migrations/20260805000100_storage_production_readiness.sql.
NEXT_PUBLIC_SUPABASE_STORAGE_ENABLED=false

# Server-only key: required by inquiry submissions, private attachment cleanup,
# and consented analytics. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Required by /api/internal/maintenance. Configure the same value in Vercel.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Authenticated admin E2E uses a separate explicitly selected staging environment.
# See docs/verification/admin-operations.md and playwright.admin.config.ts.
